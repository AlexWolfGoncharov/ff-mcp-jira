# Required
JIRA_BASE_URL=https://jira.fintech-farm.com
JIRA_API_TOKEN=your_personal_access_token

# Cloud-only (ignored on Server/DC):
# JIRA_EMAIL=you@example.com

# Optional overrides:
# JIRA_AUTH_MODE=bearer        # or "basic" (Cloud)
# JIRA_API_VERSION=2           # 2 for Server, 3 for Cloud (auto-detected)
# JIRA_TIMEOUT_MS=30000
# JIRA_MAX_RETRIES=2
# JIRA_LOG_LEVEL=info          # debug|info|warn|error
